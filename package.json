{
  "name": "tsr-www",
  "version": "0.1.0",
  "description": "TheSportsRemote.com marketing site — pure JS + Web Components + Node.js",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "nodemon server.js",
    "dev:client": "webpack serve --config webpack.dev.cjs",
    "build": "webpack --config webpack.prod.cjs",
    "clean": "rm -rf dist",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint \"src/**/*.js\" \"server/**/*.js\" server.js",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"server/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"server/**/*.js\" \"*.{js,json,md}\"",
    "test": "mocha",
    "test:watch": "mocha --watch"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase": "^10.13.0",
    "firebase-admin": "^12.5.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^25.0.0",
    "mini-css-extract-plugin": "^2.9.1",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  }
}
